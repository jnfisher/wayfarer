# wayfarer.service: a systemd user unit (docs/server.md).
#
# A release box: scripts/update.sh writes this to ~/.config/systemd/user/wayfarer.service the
# first time, with @BIND@ filled in, and leaves it alone after that. It runs the release
# update.sh last installed (releases/current). To install it by hand, copy it there and
# replace @BIND@ with this machine's Tailscale address and the port, e.g. 100.x.y.z:7373
# (`tailscale ip -4`). %h is your home directory; systemd fills it in.
#
# A box built from source (docs/server.md "Build") points ExecStart at its checkout instead,
# and keeps the world pack in the data directory:
#   ExecStart=%h/wayfarer/target/release/wayfarer serve \
#     --config %h/.local/share/wayfarer/wayfarer.toml \
#     --bind 100.x.y.z:7373 \
#     --ui-dir %h/wayfarer/ui/dist \
#     --world %h/.local/share/wayfarer/world.sqlite
[Unit]
Description=wayfarer: MajorMUD client and bot
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/share/wayfarer/releases/current/wayfarer serve \
  --config %h/.local/share/wayfarer/wayfarer.toml \
  --bind @BIND@ \
  --ui-dir %h/.local/share/wayfarer/releases/current/ui/dist \
  --world %h/.local/share/wayfarer/releases/current/world.sqlite
Restart=on-failure
RestartSec=5
# SIGTERM logs every character off cleanly; the gateway waits up to 360 s for that (a
# character under attack may need many tries).
KillSignal=SIGTERM
TimeoutStopSec=390

[Install]
WantedBy=default.target
